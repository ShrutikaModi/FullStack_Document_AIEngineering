# Supabase: Dashboard → Project Settings → API
# Database: Dashboard → Project Settings → Database → Connection string

# --- Supabase (Auth + API) ---

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# --- Postgres (Alembic + direct DB access) ---

# Locally: the DIRECT connection (host: db.<ref>.supabase.co).
# Hosted on Vercel: the TRANSACTION POOLER URL (host: *.pooler.supabase.com, port 6543), because
# Vercel connects over IPv4 only and the direct host is IPv6. Migrations refuse the transaction
# pooler; run them locally with the direct URL. URL-encode special characters in the password.
DATABASE_URL=postgresql://postgres:your-password@db.your-project-ref.supabase.co:5432/postgres

# --- OpenAI (needed once the LLM / embedding layer is wired up) ---

OPENAI_API_KEY=sk-your-openai-api-key
# Azure / Microsoft Foundry only: the resource's OpenAI v1 endpoint. Leave out for api.openai.com.
# With Azure, the model names below are your deployment names.
# OPENAI_BASE_URL=https://your-resource.services.ai.azure.com/openai/v1
OPENAI_CHAT_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536

# --- Server ---

# Comma-separated browser origins allowed to call the API (CORS).
ALLOWED_ORIGINS=http://localhost:5173

# Comma-separated emails that may use the real assistant (confirmed addresses only). Everyone else
# can only open the recorded sample questions, so strangers cannot spend model tokens. Leave empty
# and everybody is in demo mode. Set this on the host too, not just locally.
FULL_ACCESS_EMAILS=

# "console" = readable coloured log lines (local). "json" = one JSON object per line (Railway).
LOG_FORMAT=console
